@model VodManageSystem.Models.DataModels.Song

@using System
@using Microsoft.AspNetCore.Html

<link rel="stylesheet" style="text/css" href="~/css/OneRecordStyle.css" />

<style>
    /* CSS for the searchable singer dropdown */
    .singer-dropdown {
        position: relative;
        display: inline-block;
        width: 100%;
        max-width: 250px;
    }

    .singer-input {
        width: 100%;
        padding: 5px;
        box-sizing: border-box;
        border: 1px solid #ccc;
        border-radius: 4px;
        background: #fff;
    }

    .singer-list {
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        border: 1px solid #ccc;
        border-top: none;
        border-radius: 0 0 4px 4px;
        max-height: 150px;
        overflow-y: auto;
        background: white;
        z-index: 1000;
        display: none;
        list-style: none;
        padding: 0;
        margin: 0;
    }

    .singer-list.show {
        display: block;
    }

    .singer-item {
        padding: 8px;
        cursor: pointer;
        border-bottom: 1px solid #eee;
    }

    .singer-item:hover {
        background-color: #f0f0f0;
    }

    .singer-item.selected {
        background-color: #e6f7ff;
        font-weight: bold;
    }
</style>

<form id="OneSongForm" asp-controller="Songs" asp-action="@ViewBag.Action" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <table>
        <tr>
            <td class="labelname" colspan="4">
                <span class="errorMsg" style="color:blue">Error Message:</span>
                <span id="SongErrorMessage" class="errorMsg" style="color:red">@ViewData["ErrorMessage"]</span>
            </td>
        </tr>
        <tr>
            <td class="labelname">Song No.</td>
            <td>
                <!-- input type="text" id="SongNo" name="SongNo" maxlength="6" value="@Html.DisplayFor(model=>model.SongNo)" / -->
                <input asp-for="SongNo" class="first" maxlength="6" />
                <span asp-validation-for="SongNo" class="text-danger"></span>
            </td>
            <td class="labelname">Song Title</td>
            <td>
                <!-- input type="text" id="SongNa" name="SongNa" maxlength="36" value="@Html.DisplayFor(model=>model.SongNa)" / -->
                <input asp-for="SongNa" maxlength="36"/>
                <span asp-validation-for="SongNa" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <td class="labelname">Language</td>
            <td>
                <select asp-for="LanguageId" asp-items="@ViewBag.LanguageList"></select>
            </td>
            <td class="labelname">Num_Of_word</td>
            <td>
                <input type="number" asp-for="SNumWord" class="first" maxlength="2" />
                <span asp-validation-for="SNumWord" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <td class="labelname">Num_fw</td>
            <td>
                <input type="number" asp-for="NumFw" class="first" maxlength="2" />
                <span asp-validation-for="NumFw" class="text-danger"></span>
            </td>
            <td class="labelname">Num_pw</td>
            <td>
                <input asp-for="NumPw" class="first" maxlength="1" />
                <span asp-validation-for="NumPw" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <td class="labelname">Singer 1</td>
            <td>
                <div class="singer-dropdown">
                    <input type="text" class="singer-input" id="Singer1Search" placeholder="Select Singer 1..." />
                    <input type="hidden" id="Singer1Id" asp-for="Singer1Id" />
                    <ul id="Singer1List" class="singer-list"></ul>
                </div>
                <span id="Singer1ValidationMessage" asp-validation-for="Singer1Id" class="text-danger"></span>
            </td>
            <td class="labelname">Singer 2</td>
            <td>
                <div class="singer-dropdown">
                    <input type="text" class="singer-input" id="Singer2Search" placeholder="Select Singer 2..." />
                    <input type="hidden" id="Singer2Id" asp-for="Singer2Id" />
                    <ul id="Singer2List" class="singer-list"></ul>
                </div>
                <span id="Singer2ValidationMessage" asp-validation-for="Singer2Id" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <td class="labelname">Chor</td>
            <td>
                <select asp-for="Chor">
                    <option value="N">No</option>
                    <option value="Y">Yes</option>
                </select>
                <span asp-validation-for="Chor" class="text-danger"></span>
            </td>
            <td class="labelname">Vod_yn</td>
            <td>
                <select asp-for="VodYn">
                    <option value="Y">Yes</option>
                    <option value="N">No</option>
                </select>
                <span asp-validation-for="VodYn" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <td class="labelname">Music_track</td>
            <td>
                <input asp-for="NMpeg" class="first" maxlength="2" />
                <span asp-validation-for="NMpeg" class="text-danger"></span>
            </td>
            <td class="labelname">Vocal_Track</td>
            <td>
                <input asp-for="MMpeg" class="first" maxlength="2" />
                <span asp-validation-for="MMpeg" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <td class="labelname">Vod_no</td>
            <td>
                <input asp-for="VodNo" class="first" maxlength="30" />
                <span asp-validation-for="VodNo" class="text-danger"></span>
            </td>
            <td class="labelname">PathName</td>
            <td>
                <input asp-for="Pathname" maxlength="80" />
                <span asp-validation-for="Pathname" class="text-danger"></span>
            </td>
        </tr>
        <tr>
            <td class="labelname">In_Date</td>
            <td>
                <input type="hidden" asp-for="OrdNo" />
                <input type="hidden" asp-for="OrderNum" />
                <input type="hidden" asp-for="OrdOldN" />
                <input type="date" asp-for="InDate" class="first" />
                <span asp-validation-for="InDate" class="text-danger"></span>
            </td>
            <td colspan="2"></td>
        </tr>
        <tr>
            <td class="labelname"></td>
            <td style="text-align:center" colspan="3">
                @{
                    string _action = ((string)ViewBag.Action).Trim();
                    if (_action != "Details")
                    {
                        string inputStr = "";
                        if ( (_action == "Add") || (_action == "Edit") )
                        {
                            inputStr = "<input class='submit' type='submit' name='submitbutton' value='Submit' />";

                        } else if (_action == "Delete")
                        {
                            inputStr = "<input formnovalidate='formnovalidate' class='submit' type='submit' name='submitbutton' value='Submit' />";
                        }
                    inputStr += "&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;";
                    ViewData["InputButton"] = new HtmlString(inputStr);
                    }
                }       
                @ViewData["InputButton"]
                <input formnovalidate="formnovalidate" class="submit" type="submit" name="submitbutton" value="Cancel"/>
            </td>
        </tr>
    </table>
    <input type="hidden" name="song_state" value="@ViewBag.SongState" />
    @Html.HiddenFor(model=>model.Id)
</form>

<script>
    // Assuming ViewBag.SingerList contains SelectListItem objects with .Text and .Value
    const singerData = @Html.Raw(Json.Serialize(ViewBag.SingerList));

    function setSingerValidationMessage(inputId, hiddenId, validationId) {
        const input = document.getElementById(inputId);
        const hidden = document.getElementById(hiddenId);
        const validation = document.getElementById(validationId);
        const errorMessage = document.getElementById('SongErrorMessage');

        if (!input || !hidden || !validation) return false;

        if (input.value.trim() && !hidden.value) {
            validation.textContent = 'singer does not exist';
            if (errorMessage) {
                errorMessage.textContent = 'singer does not exist';
            }
            return true;
        }

        validation.textContent = '';
        return false;
    }

    function validateSingerSelections() {
        const singer1Invalid = setSingerValidationMessage('Singer1Search', 'Singer1Id', 'Singer1ValidationMessage');
        const singer2Invalid = setSingerValidationMessage('Singer2Search', 'Singer2Id', 'Singer2ValidationMessage');
        return !(singer1Invalid || singer2Invalid);
    }

    function initSingerDropdown(inputId, listId, hiddenId) {
        const input = document.getElementById(inputId);
        const list = document.getElementById(listId);
        const hidden = document.getElementById(hiddenId);

        if (!input || !list || !hidden) return;

        let isDropdownOpen = false;

        // Populate list
        function renderList(filterText = '') {
            list.innerHTML = '';
            const lowerFilter = filterText.toLowerCase();

            singerData.forEach(item => {
                // Assuming item.Text is the name and item.Value is the ID
                if (item.Text.toLowerCase().includes(lowerFilter)) {
                    const li = document.createElement('li');
                    li.className = 'singer-item';
                    li.textContent = item.Text;
                    li.dataset.value = item.Value;
                    li.dataset.text = item.Text;
                    
                    li.addEventListener('click', () => {
                        selectSinger(item.Value, item.Text);
                    });
                    list.appendChild(li);
                }
            });

            if (list.children.length > 0) {
                list.classList.add('show');
            } else {
                list.classList.remove('show');
            }
        }

        function selectSinger(value, text) {
            input.value = text;
            hidden.value = value;
            list.classList.remove('show');
            isDropdownOpen = false;
            const validationId = inputId === 'Singer1Search' ? 'Singer1ValidationMessage' : 'Singer2ValidationMessage';
            const validation = document.getElementById(validationId);
            if (validation) {
                validation.textContent = '';
            }
            const errorMessage = document.getElementById('SongErrorMessage');
            if (errorMessage && errorMessage.textContent === 'singer does not exist') {
                errorMessage.textContent = '';
            }
            // Remove any existing selected class
            const items = list.querySelectorAll('.singer-item');
            items.forEach(i => i.classList.remove('selected'));
        }

        // Event Listeners
        input.addEventListener('input', (e) => {
            hidden.value = '';
            renderList(e.target.value);
            isDropdownOpen = true;
            setSingerValidationMessage(inputId, hiddenId, inputId === 'Singer1Search' ? 'Singer1ValidationMessage' : 'Singer2ValidationMessage');
        });

        input.addEventListener('focus', () => {
            if (!isDropdownOpen) {
                renderList(input.value);
                isDropdownOpen = true;
            }
        });

        // Close dropdown when clicking outside
        document.addEventListener('click', (e) => {
            if (!input.contains(e.target) && !list.contains(e.target)) {
                list.classList.remove('show');
                isDropdownOpen = false;
            }
        });

        // Handle existing value on page load (for Edit mode)
        if (hidden.value) {
            // To set the text correctly on load, we need to find the item in singerData
            const foundItem = singerData.find(i => i.Value == hidden.value);
            if (foundItem) {
                input.value = foundItem.Text;
            } else {
                // Fallback if value exists but not in list (shouldn't happen normally)
                input.value = hidden.value;
            }
        }
    }

    // Initialize both dropdowns
    document.addEventListener('DOMContentLoaded', () => {
        initSingerDropdown('Singer1Search', 'Singer1List', 'Singer1Id');
        initSingerDropdown('Singer2Search', 'Singer2List', 'Singer2Id');

        const form = document.getElementById('OneSongForm');
        if (form) {
            form.addEventListener('submit', (event) => {
                if (!validateSingerSelections()) {
                    event.preventDefault();
                }
            });
        }
    });
</script>